;; Test 1: Register Restoration Bug
;; CALL should preserve the caller's register values.
;; Expected output: 2

.global_start
  MOV R0, 2
  CALL func_modify_r0
  PRINT R0
  CALL global_test2

func_modify_r0:
  MOV R0, 5
  RET


;; Test 2: Flag State Preservation in Nested Calls
;; CALL should preserve the caller's flag state.
;; Expected output: 1

global_test2:
  MOV R0, 10
  CMPR R0, 10
  CALL check_flag
  RET

check_flag:
  JMPE flag_ok
  PRINT 0
  RET

flag_ok:
  PRINT 1
  CALL global_test3
  RET


;; Test 3: Division by Zero Protection
;; DIV by zero should produce a clear runtime error.

global_test3:
  MOV R0, 10
  MOV R1, 0
  DIV R2, R0, R1
  PRINT R2
  HLT
