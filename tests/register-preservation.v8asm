; Test register preservation when jumping to labels
; This test verifies that R1 value is preserved across label jumps

.section_data
    result = 0

.global_start
    MOV R0, 5
    MOV R1, 100    ; R1 holds important value (limit)
    MOV R2, 0      ; R2 is counter
    
    LOOP:
    CMPR R0, R2
    JMPE END_LOOP
    
    ; R1 should still be 100 here after returning from label
    ADD R2, R2, 1
    JMP LOOP
    
    END_LOOP:
    ; Verify R1 is still 100 (preserved from before LOOP)
    PRINT R1
    HLT
