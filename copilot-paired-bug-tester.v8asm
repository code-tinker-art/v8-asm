;; Test 1: Register Restoration Bug - CALL should preserve caller's register values
;; Before fix: Would print 5 (registers weren't restored)
;; After fix: Should print 2 (R0 restored after function call)
.global_start
  MOV R0, 2
  CALL func_modify_r0
  PRINT R0
  HLT

func_modify_r0:
  MOV R0, 5
  RET

;; Test 2: Flag State Preservation in Nested Calls
;; Before fix: equalFlag would be lost in nested calls
;; After fix: Should correctly restore flag state
.global_test2
  MOV R0, 10
  CMPR R0, 10
  CALL check_flag
  HLT

check_flag:
  ;; If equalFlag was preserved, JMPE should work
  JMPE flag_ok
  PRINT 0
  RET
flag_ok:
  PRINT 1
  RET

;; Test 3: Division by Zero Protection
;; Before fix: Would silently fail or crash
;; After fix: Should throw clear error
.global_test3
  MOV R0, 10
  MOV R1, 0
  DIV R2, R0, R1
  PRINT R2
  HLT
